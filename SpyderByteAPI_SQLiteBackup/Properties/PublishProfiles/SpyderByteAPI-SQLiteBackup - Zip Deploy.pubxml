<Project>
  <PropertyGroup>
    <WebPublishMethod>ZipDeploy</WebPublishMethod>
    <PublishProvider>AzureWebSite</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>https://spyderbyteapi-sqlitebackup.azurewebsites.net</SiteUrlToLaunchAfterPublish>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
    <ResourceId>/subscriptions/4b3d0359-9e3b-4a16-ab8c-c3f872bc4f52/resourceGroups/SpyderByteAPI-ResourceGroup/providers/Microsoft.Web/sites/SpyderByteAPI-SQLiteBackup</ResourceId>
    <UserName>$SpyderByteAPI-SQLiteBackup</UserName>
    <_SavePWD>true</_SavePWD>
    <PublishUrl>https://spyderbyteapi-sqlitebackup.scm.azurewebsites.net/</PublishUrl>
  </PropertyGroup>
</Project>